<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Net.ServerSentEvents" VersionOverride="10.0.0-preview.3.25171.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dto\Dto.csproj" />
  </ItemGroup>
  <!--
    Zips the proxy for embedding into the VSIX. Skipped when the project is built on its own rather
    than through the solution - $(SolutionDir) is then "*Undefined*" and the Exec would fail. The
    only build that does that is the test project's, which has no use for the zip.
  -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">
    <Exec Command="if exist $(SolutionDir).art\Proxy.zip del /F /Q $(SolutionDir).art\Proxy.zip&#xD;&#xA;PowerShell.exe -Command &quot;Add-Type -A 'System.IO.Compression.FileSystem'; [IO.Compression.ZipFile]::CreateFromDirectory('$(SolutionDir)MCP\Proxy\$(OutDir)', '$(SolutionDir).art\Proxy.zip')&quot;" />
  </Target>
</Project>