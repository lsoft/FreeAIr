<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Types shared between assemblies that cannot reference each other: the CodeLens pipe name and
    its DTOs, which the CodeLens process needs and the VSIX cannot hand it, plus the leaf helpers
    that the VSIX, FreeAIr.Voice and CodeLens all use.

    SDK-style so that the sources are globbed. In the legacy format every file had to be listed in
    a Compile item by hand, and one left out was silently not compiled - the build still reported
    no errors, and the missing type only surfaced at run time.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>FreeAIr.Shared</RootNamespace>
    <AssemblyName>FreeAIr.Shared</AssemblyName>
    <LangVersion>9</LangVersion>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable;CS8766;CS8767</WarningsAsErrors>
    <UseWPF>true</UseWPF>
    <!-- Properties\AssemblyInfo.cs is hand written, as in FreeAIr.csproj. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- bin\Debug\, not bin\Debug\net48\ - the paths the legacy project produced. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualStudio.Text.Data, Version=16.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Reference-only: these assemblies live in the Visual Studio install, so nothing from this
      package ends up in the VSIX or in the CodeLens process' output.
    -->
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" />
  </ItemGroup>

</Project>
