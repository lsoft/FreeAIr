<Project>

  <!--
    SDK-style VSIX project. The Sdk.props/Sdk.targets imports are written out by hand instead of
    using the Sdk="..." attribute, because Microsoft.VsSDK.targets has to be imported *after* the
    C# targets - exactly the order the legacy project file used - and the attribute form appends
    Sdk.targets at the very end of the file.

    Microsoft.VSSDK.BuildTools points $(VSToolsPath) at its own tools directory from its .props,
    so the import below resolves to the package copy of the VSSDK targets, not to one installed
    with Visual Studio.
  -->

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>Preview</LangVersion>
    <RootNamespace>FreeAIr</RootNamespace>
    <AssemblyName>FreeAIr</AssemblyName>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <OutputType>Library</OutputType>
    <UseWPF>true</UseWPF>

    <!-- Properties\AssemblyInfo.cs is hand written and takes its values from source.extension.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the legacy resource naming: manifest names come from the folder, not from a sibling .Designer.cs. -->
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
    <!-- Everything that is not code is listed explicitly below; a default None glob would double up on it. -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- bin\Release\, not bin\Release\net48\ - the VSIX path is referenced by docs and scripts. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>

    <!--
      There is deliberately no StartAction/StartProgram/StartArguments here. Now that the project
      is SDK-style, F5 is owned by Visual Studio's own extensibility project system
      (Microsoft.VisualStudio.Sdk.ProjectSystem, rule "VsixDebugger"), which starts
      devenv /rootSuffix Exp by itself and ignores those three properties entirely. What it does
      read is AdditionalArguments - a per-user setting, so it belongs in FreeAIr.csproj.user, or
      in Project Properties > Debug. Put the solution the experimental instance should open there.
    -->

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- Generated files, listed only so the IDE nests them under what generates them. -->
  <ItemGroup>
    <Compile Update="Resources\Resources1.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="source.extension.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>source.extension.vsixmanifest</DependentUpon>
    </Compile>
    <Compile Update="VSCommandTable.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>VSCommandTable.vsct</DependentUpon>
    </Compile>
  </ItemGroup>

  <!--
    ClickableTextResource.xaml is not a Page: it is loaded by manifest name at runtime
    (EmbeddedResourceHelper.LoadXamlEmbeddedResource in FreeAIrPackage), so it must stay out of
    the XAML compiler and keep the folder-derived resource name.
  -->
  <ItemGroup>
    <Page Remove="UI\ClickableText\ClickableTextResource.xaml" />
    <EmbeddedResource Include="UI\ClickableText\ClickableTextResource.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <SubType>Designer</SubType>
      <LastGenOutput>Resources1.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Resources.ru.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
      <Generator>VsixManifestGenerator</Generator>
      <LastGenOutput>source.extension.cs</LastGenOutput>
    </None>
    <Resource Include="Resources\Icon16.png" />
    <Resource Include="Resources\Icon32.png" />
    <Content Include="Resources\Icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\RELEASE_NOTES.md">
      <Link>RELEASE_NOTES.md</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Monikers.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Antlr4 Include="Antlr\Prompt\PromptMarkdown.g4">
      <Listener>true</Listener>
      <Visitor>true</Visitor>
      <GAtn>true</GAtn>
      <Error>true</Error>
      <Package>FreeAIr.Antlr</Package>
    </Antlr4>
    <Antlr4 Include="Antlr\Context\ContextMarkdown.g4">
      <Generator>MSBuild:Compile</Generator>
    </Antlr4>
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
      <Generator>VsctGenerator</Generator>
      <LastGenOutput>VSCommandTable.cs</LastGenOutput>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OpenAI, Version=2.1.0.0, Culture=neutral, PublicKeyToken=b4187f3e65366280, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>..\.bin\OpenAI\OpenAI.dll</HintPath>
    </Reference>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Antlr4BuildTasks" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Community.VisualStudio.VSCT" PrivateAssets="all" />
    <PackageReference Include="Community.VisualStudio.Toolkit.17" ExcludeAssets="Runtime">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DiffPatch" />
    <PackageReference Include="editorconfig" />
    <PackageReference Include="Extended.Wpf.Toolkit" />
    <PackageReference Include="FuzzySharp" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.EditorFeatures.Wpf" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.VisualStudio.CoreUtility" />
    <PackageReference Include="Microsoft.VisualStudio.Language" />
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" />
    <PackageReference Include="Microsoft.VisualStudio.TeamFoundation.Git.Extensibility" />
    <PackageReference Include="Microsoft.VisualStudio.Text.Logic" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="NuGet.VisualStudio" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="RunProcessAsTask" />
    <PackageReference Include="System.ClientModel" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="System.Net.ServerSentEvents" />
  </ItemGroup>

  <!--
    The two projects the vsixmanifest names in a d:ProjectName attribute need explicit <Name/>
    metadata: that is what DetokenizeVsixManifestFile matches the manifest against, and the SDK
    does not fill it in on its own.
  -->
  <ItemGroup>
    <ProjectReference Include="..\CodeLens\FreeAIr.CodeLens.csproj">
      <Name>FreeAIr.CodeLens</Name>
    </ProjectReference>
    <ProjectReference Include="..\MarkdownParser\MarkdownParser.csproj">
      <Name>MarkdownParser</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup%3bBuiltProjectOutputGroupDependencies%3bGetCopyToOutputDirectoryItems%3bSatelliteDllsProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
      <IncludeOutputGroupsInVSIXLocalOnly>DebugSymbolsProjectOutputGroup%3b</IncludeOutputGroupsInVSIXLocalOnly>
    </ProjectReference>
    <ProjectReference Include="..\MCP\Dto\Dto.csproj" />
    <ProjectReference Include="..\Search\FreeAIr.Search.csproj" />
    <ProjectReference Include="..\SetupWizard\FreeAIr.SetupWizard.csproj" />
    <ProjectReference Include="..\Shared\FreeAIr.Shared.csproj" />
    <!--
      Only the assembly itself, unlike MarkdownParser above. GetCopyToOutputDirectoryItems would
      drag Whisper.net.Runtime's native libraries for every platform into the VSIX loose, on top of
      the win-x64 zip the extension actually unpacks; BuiltProjectOutputGroupDependencies would add
      the WinRT projection facades, which belong to the framework. Everything this assembly needs
      at run time is already copy-local here through the reference chain.
    -->
    <ProjectReference Include="..\Voice\FreeAIr.Voice.csproj">
      <Name>FreeAIr.Voice</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup%3bSatelliteDllsProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
      <IncludeOutputGroupsInVSIXLocalOnly>DebugSymbolsProjectOutputGroup%3b</IncludeOutputGroupsInVSIXLocalOnly>
    </ProjectReference>
    <ProjectReference Include="..\WpfHelpers\WpfHelpers.csproj" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />

  <!-- The proxy and the Whisper natives are zipped by the build and ride along inside the VSIX. -->
  <Target Name="IncludeNuGetPackageReferences" AfterTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="$(SolutionDir).art\Proxy.zip" TargetPath="MCP\Proxy\Archive\Proxy.zip" />
      <VSIXSourceItem Include="$(SolutionDir).art\WhisperNet.Runtime.zip" TargetPath="runtimes\WhisperNet.Runtime.zip" />
      <VSIXSourceItem Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'System.IO.Pipelines'" />
      <VSIXSourceItem Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'System.Text.Json'" />
      <VSIXSourceItem Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.Bcl.AsyncInterfaces'" />
    </ItemGroup>
  </Target>
</Project>
